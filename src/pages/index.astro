---
import MainLayout from "../layouts/MainLayout.astro";
import { siteConfig, news, projects, education, experience } from "../data/site";
import TagPill from "../components/TagPill.astro";
const base = import.meta.env.BASE_URL;
const withBase = (url) => (url?.startsWith("/") ? `${base}${url.slice(1)}` : url);
---
<MainLayout title={siteConfig.name} current="/">
  <main class="container">
    <div class="home-shell">
      <aside class="home-sidebar">
        <div class="home-sidebar-sticky">
          <div class="card profile-card reveal">
            <img
              class="profile-image"
              src={`${base}profile.jpg`}
              alt={`${siteConfig.name} profile photo`}
            />
          </div>

          <div class="card sidebar-block reveal">
            <h3 style="margin: 0 0 0.65rem;">Contact</h3>
            <p style="margin: 0.2rem 0;">Email: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
            <p style="margin: 0.2rem 0;">Location: {siteConfig.location}</p>
            <p style="margin: 0.2rem 0;"><a href={withBase(siteConfig.social.googleScholar)}>Google Scholar</a></p>
            <p style="margin: 0.2rem 0;"><a href={withBase(siteConfig.social.github)}>GitHub</a></p>
            <p style="margin: 0.2rem 0;"><a href={withBase(siteConfig.social.linkedin)}>LinkedIn</a></p>
            <p style="margin: 0.2rem 0;"><a href={withBase(siteConfig.social.cv)}>CV (PDF)</a></p>
          </div>
        </div>
      </aside>

      <div class="home-content">
        <section class="hero reveal">
          <p class="muted">{siteConfig.role} • {siteConfig.affiliation}</p>
          <h1>{siteConfig.name}</h1>
          <p class="hero-intro">
            I am an M.S. candidate at Seoul National University, focusing on <strong>HCI</strong>, especially
            <strong> Human-AI Interaction (HAI)</strong>.<br />
            I investigate how LLM and data science methods can be used in ways that are trustworthy, ethical, and socially valuable.
          </p>
          <div class="hero-tags">
            {siteConfig.interests.map((interest) => <TagPill label={interest} />)}
          </div>
        </section>

        <section class="section section-tight reveal">
          <h2>About</h2>
          <div class="card" style="padding: 1.2rem;">
            <p>
              My research focuses on Human-AI Interaction (HAI), with a specific interest in how people can effectively
              and safely use AI systems such as large language models (LLMs) in real-world domains. I design LLM- and
              visualization-based tools that make AI-powered analysis and decision-making more accessible and trustworthy
              across diverse contexts.
            </p>

            <div style="margin-top: 1.1rem;">
              <h3 class="timeline-title">Education</h3>
              <div class="timeline-list">
                {education.map((item) => (
                  <article class="timeline-item">
                    <strong>{item.degree}</strong>
                    <p class="muted" style="margin: 0.2rem 0;">{item.school} • {item.period}</p>
                    {item.detail && <p style="margin: 0;">{item.detail}</p>}
                    {item.advisor && (
                      <p style="margin: 0.15rem 0 0;">
                        Advisor:{" "}
                        {item.advisorUrl ? (
                          <a href={item.advisorUrl} target="_blank" rel="noreferrer">{item.advisor}</a>
                        ) : item.advisor}
                      </p>
                    )}
                  </article>
                ))}
              </div>
            </div>

            <div style="margin-top: 1.1rem;">
              <h3 class="timeline-title">Professional Experience</h3>
              <div class="timeline-list">
                {experience.map((item) => (
                  <article class="timeline-item">
                    <strong>{item.title}</strong>
                    <p class="muted" style="margin: 0.2rem 0;">{item.org} • {item.period}</p>
                    {item.detail && <p style="margin: 0;">{item.detail}</p>}
                  </article>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section class="section section-tight reveal">
          <h2>Recent News</h2>
          <div class="grid">
            {news.map((item) => (
              <div class="card" style="padding: 1rem;">
                <strong>{item.date}</strong>
                <p style="margin: 0.35rem 0 0;">{item.text}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="section section-tight reveal">
          <h2>Ongoing Work</h2>
          <div class="grid grid-2">
            {projects.map((p) => (
              <article class="card" style="padding: 1rem;">
                <h3 style="margin-top: 0;">{p.title}</h3>
                <p class="muted">{p.summary}</p>
                <div>{p.tags.map((tag) => <TagPill label={tag} />)}</div>
              </article>
            ))}
          </div>
        </section>
      </div>
    </div>
  </main>
</MainLayout>
